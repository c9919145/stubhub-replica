# ==== Server / App ====
PORT=3000
NODE_ENV=development
# Public URL of this app. Used to build Stripe success/cancel URLs.
BASE_URL=http://localhost:3000

# ==== Database ====
# Path to the SQLite file (created automatically). ":memory:" is allowed.
DB_PATH=data/app.db
# Minutes a reserved order is held before the reservation is released.
RESERVATION_TTL_MINUTES=30

# ==== Stripe (TEST MODE placeholders — never paste live keys) ====
PAYMENT_SECRET_KEY=CHANGE_ME_your_stripe_test_secret
PAYMENT_PUBLISHABLE_KEY=CHANGE_ME_your_stripe_test_publishable
# From the Stripe dashboard: Developers -> Webhooks. Test signing secret starts with whsec_.
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_your_stripe_webhook_signing_secret

# ==== PayPal (TEST/SANDBOX credentials, never live keys) ====
# From https://developer.paypal.com -> Apps & Credentials (sandbox app).
# Client ID and secret of a REST app owned by the merchant account.
PAYPAL_CLIENT_ID=CHANGE_ME_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=CHANGE_ME_paypal_sandbox_secret
# sandbox or live. Keep sandbox for development.
PAYPAL_MODE=sandbox
# Webhook ID: Developer apps -> your sandbox app -> Webhooks. Used to verify
# PayPal webhook signatures server-side (Webhooks v1 verify-webhook-signature).
PAYPAL_WEBHOOK_ID=CHANGE_ME_paypal_webhook_id
# Merchant (payee) email that should receive the funds. Used to set the PayPal
# payee — must match the account that owns the app credentials above.
PAYPAL_MERCHANT_EMAIL=CHANGE_ME@example.com

# ==== Gift cards ====
# Default expiry for admin-created gift cards when no expiry is given (days).
GIFT_CARD_DEFAULT_LIFE_DAYS=365

# ==== Customer wallet ====
# Receiving addresses for crypto wallet top-ups. These defaults match the
# addresses shown on the public payment-methods page; change them if you point
# your own wallet here. The wallet is only credited AFTER the payment is
# confirmed (Stripe webhook for cards, on-chain/manual confirmation for crypto).
WALLET_ADDRESS_BTC=bc1q82haxrn0a0utrm3usnq7ajecumvqzk453v54vu
WALLET_ADDRESS_ETH=0x814Bb1edC49Cebb9f592556333Ae3d5A626f7a60

# ==== Fees ====
# Service fee is a percentage of the subtotal, computed on the server.
FEE_RATE=0.10

# ==== Cookies / Sessions ====
# Set COOKIE_SECURE=true when serving over HTTPS in production.
COOKIE_SECURE=false
SESSION_TTL_HOURS=24

# ==== Auth rate limiting ====
# Login/register/order abuse protection. Set RATE_LIMIT_ENABLED=false for local debugging.
RATE_LIMIT_ENABLED=true

# ==== Saved payment methods (Stripe Checkout) ====
# When true, returning users may save a payment method in Stripe Checkout.
# Requires the logged-in user to have a Stripe customer id (stored on users.stripe_customer_id).
ENABLE_SAVED_PAYMENT_METHODS=false

# ==== Admin (used by the seed script only) ====
ADMIN_EMAIL=admin@ticketvault.test
ADMIN_PASSWORD=adminpass123